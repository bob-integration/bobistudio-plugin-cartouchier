{
  "license": "GPL-3.0-or-later",
  "type": "cartouchier",
  "label": "Cartouchier",
  "runtime": "docker",
  "image": "media",
  "media_volume": true,
  "state_volume": true,
  "version": "0.1.12",
  "description": "Cartouchier : touches sonores en grille à pages ou en playlist A/B, sur N lecteurs stéréo (un flux MXL audio chacun). Boucle, enchaînement, exclusivité, fondu d'arrêt, deuxième appui réglable, normalisation EBU R128 au chargement, décompte, forme d'onde, intro / fin. Publie l'état de chaque flux (GET /flows) pour la console.",
  "badge": {
    "label": "Cart",
    "class": "mode-cart",
    "oklch": "0.78 0.06 40"
  },
  "video_format": false,
  "script_template": "script.py",
  "files": [
    {
      "src": "src/__init__.py",
      "dest": "cart/__init__.py"
    },
    {
      "src": "src/engine.py",
      "dest": "cart/engine.py"
    },
    {
      "src": "src/loudness.py",
      "dest": "cart/loudness.py"
    },
    {
      "src": "src/media.py",
      "dest": "cart/media.py"
    },
    {
      "src": "src/montage.py",
      "dest": "cart/montage.py"
    },
    {
      "src": "src/listen.py",
      "dest": "cart/listen.py"
    }
  ],
  "nav": {
    "section": "medias",
    "label": "Medias",
    "route": "/medias",
    "order": 12
  },
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css",
    "public_page": true,
    "public_tabs": "/tabs"
  },
  "_resources_mesure": "MÉMOIRE (relevée le 2026-10-30, r620-2 #1176, 2 onglets, 1 zone, 1 lecteur, 7 cartouches en liste) : 60 à 62 Mio pour une limite déclarée de 1024 (6 %). Méthode : `memory.current` du cgroup, tel que l'orchestrateur le relève à chaque tour sur l'agent (:8081/stats → champ `mem_used`), lu en lecture seule par GET /api/containers : 21 relevés à 10 s d'écart entre 13:17 et 13:21. La part shmem (bus MXL mappé, ≈ 1/5 sur decklink_io) n'est PAS disponible par cette voie ; la limite effectivement posée au conteneur (memory.max) non plus — le rapport est donc pris sur le chiffre DÉCLARÉ. ⚠ CONFIGURATION LÉGÈRE : ce relevé dit que CETTE configuration tient, pas que 1024 Mio paie une configuration pleine ; la limite n'a été ni baissée ni montée (chantier de documentation, 2026-10-30). À REMESURER sur une configuration pleine, en lisant memory.stat (anon / shmem / pgscan_direct) du cgroup, avant de toucher au chiffre.",
  "resources": {
    "cores": 1,
    "memory": 1024,
    "pin": true,
    "cap_add": [
      "SYS_NICE"
    ],
    "ulimits": {
      "rtprio": 20
    }
  },
  "deploy_defaults": {
    "players": 2,
    "media_root": "/mnt/media",
    "log_level": "info",
    "cache_max_mb": 4096,
    "max_media_s": 1200
  },
  "config_schema": [
    {
      "key": "players",
      "type": "number",
      "label": "Lecteurs (flux stéréo)",
      "min": 1,
      "max": 8,
      "default": 2,
      "help": "Nombre de lecteurs, donc de flux MXL audio stéréo produits. Une touche lancée prend un lecteur libre, ou celui qui lui est affecté ; la playlist A/B en utilise deux. Changer ce nombre redéploie (les flux sont créés au démarrage)."
    },
    {
      "key": "cache_max_mb",
      "type": "number",
      "label": "Cache des sons décodés (Mo)",
      "min": 256,
      "max": 65536,
      "default": 4096,
      "help": "Les sons sont décodés une fois (PCM 48 kHz stéréo, ≈ 23 Mo par minute) sur le volume d'état du conteneur et lus de là. Au-delà de ce plafond, les sons les plus anciennement utilisés et qu'aucune touche ne référence sont effacés."
    },
    {
      "key": "max_media_s",
      "type": "number",
      "label": "Durée maximale d'un son (s)",
      "min": 10,
      "max": 7200,
      "default": 1200,
      "help": "Un média plus long est tronqué au décodage. Un cartouchier lit des sons courts : ce plafond évite qu'un film glissé par erreur sur une touche remplisse le disque."
    },
    {
      "key": "rt_priority",
      "type": "number",
      "label": "Fil audio temps réel (priorité, 0 = normal)",
      "default": 10,
      "min": 0,
      "max": 20,
      "hidden": true
    },
    {
      "key": "log_level",
      "type": "select",
      "label": "Niveau de journal",
      "default": "info",
      "options": [
        {
          "value": "debug",
          "label": "debug"
        },
        {
          "value": "info",
          "label": "info"
        },
        {
          "value": "warning",
          "label": "warning"
        },
        {
          "value": "error",
          "label": "error"
        }
      ]
    }
  ],
  "wiring": {
    "produces": [
      {
        "essence": "audio",
        "repeat": "players",
        "shm": "{hostname}_player_{i1}",
        "label": "Lecteur {i1}",
        "format": {
          "sample_rate": 48000,
          "bit_depth": 24,
          "channels": 2
        }
      }
    ],
    "consumes": [],
    "mode": "redeploy",
    "state_endpoint": "/state"
  },
  "control": {
    "endpoints": [
      "/state",
      "/doc",
      "/flows",
      "/keys",
      "/pages",
      "/players",
      "/items",
      "/waveform",
      "/fire",
      "/stop",
      "/stop_all",
      "/page",
      "/pl/go",
      "/pl/next",
      "/pl/prev",
      "/pl/goto",
      "/pl/options",
      "/player/play",
      "/player/pause",
      "/player/stop",
      "/key",
      "/pages",
      "/grid",
      "/mode",
      "/playlist",
      "/settings",
      "/defaults",
      "/assign",
      "/media/rescan",
      "/capture",
      "/recall",
      "/wave",
      "/montage/wave",
      "/montage/render",
      "/montage/job",
      "/preview",
      "/preview/stop",
      "/zones",
      "/tabs",
      "/tab",
      "/layout",
      "/zone",
      "/set"
    ],
    "flow_status": {
      "endpoint": "/flows",
      "panel": true
    },
    "read_endpoints": [
      "/state",
      "/doc",
      "/flows",
      "/keys",
      "/pages",
      "/players",
      "/items",
      "/waveform",
      "/capture",
      "/wave",
      "/montage/job",
      "/zones",
      "/tabs"
    ],
    "persist": {
      "param": "cart",
      "snapshot": "/doc",
      "settings": [
        "/key",
        "/pages",
        "/grid",
        "/mode",
        "/playlist",
        "/settings",
        "/defaults",
        "/assign",
        "/page",
        "/pl/options",
        "/recall",
        "/tab",
        "/tabs",
        "/layout",
        "/zone",
        "/set"
      ]
    },
    "recall": {
      "source": "plugin_store",
      "scope": "",
      "endpoint": "/recall",
      "capture": "/capture",
      "apply": "post",
      "kinds": [
        "grid",
        "playlist",
        "page"
      ],
      "note": "Sauvegardes du cartouchier : bibliothèque COMMUNE à l'installation (plugin_store, portée globale), trois genres rangés dans value.kind (grille, playlist, page). Capture : GET /capture?kind=&page=&zone= ; rappel : POST /recall {kind, payload, name, page, add, zone} (zone absente = zone par défaut du genre) — générique (`apply: post`, app/plugin_library.py), sans coupure de ce qui joue."
    },
    "streams": [
      {
        "path": "/listen.pcm",
        "method": "GET",
        "perm": "read",
        "content_type": "audio/L16;rate=48000;channels=2"
      }
    ],
    "public_actions": [
      "/fire",
      "/stop",
      "/pl/go",
      "/player/play",
      "/player/stop"
    ]
  },
  "param_tree": {
    "global_groups": [
      {
        "label": "Niveaux",
        "endpoint": "/settings",
        "path_prefix": "settings",
        "fields": {
          "normalize": {
            "label": "Normalisation R128",
            "type": "bool",
            "default": true
          },
          "target_lufs": {
            "label": "Cible (LUFS)",
            "type": "number",
            "min": -40,
            "max": -5,
            "step": 0.5,
            "default": -23
          },
          "max_gain_db": {
            "label": "Gain maximal de normalisation (dB)",
            "type": "number",
            "min": 0,
            "max": 30,
            "step": 0.5,
            "default": 12
          },
          "alert_s": {
            "label": "Seuil d'alerte du décompte (s)",
            "type": "number",
            "min": 0,
            "max": 120,
            "step": 1,
            "default": 10
          }
        }
      },
      {
        "label": "Défauts des touches",
        "endpoint": "/defaults",
        "path_prefix": "defaults",
        "fields": {
          "fade_out_ms": {
            "label": "Fondu d'arrêt par défaut (ms)",
            "type": "duration",
            "min": 0,
            "max": 30000,
            "step": 100,
            "default": 0
          },
          "second_press": {
            "label": "Deuxième appui par défaut",
            "type": "enum",
            "options": [
              "stop",
              "pause",
              "restart"
            ],
            "default": "stop"
          },
          "loop": {
            "label": "Boucle par défaut",
            "type": "bool",
            "default": false
          },
          "group": {
            "label": "Groupe d'exclusivité par défaut",
            "type": "text",
            "default": ""
          },
          "player": {
            "label": "Lecteur affecté par défaut (0 = libre)",
            "type": "number",
            "min": 0,
            "max": 8,
            "step": 1,
            "default": 0
          }
        }
      },
      {
        "label": "Playlist A/B",
        "endpoint": "/pl/options",
        "path_prefix": "playlist",
        "fields": {
          "ab_handover": {
            "label": "Au lancement du suivant, l'élément de l'autre lecteur (keep = laisser jouer, cut = couper, fade = fondu)",
            "type": "enum",
            "options": [
              "keep",
              "cut",
              "fade"
            ],
            "default": "keep"
          },
          "ab_handover_ms": {
            "label": "Durée du fondu de passage A/B (ms)",
            "type": "duration",
            "min": 0,
            "max": 30000,
            "step": 100,
            "default": 1000
          }
        }
      }
    ],
    "by_id": {
      "document": "cart",
      "catalog": "zones.json",
      "set": {
        "endpoint": "/set",
        "path_key": "path",
        "value_key": "value"
      },
      "read_endpoint": "/doc",
      "roots": [
        {
          "list": "zones",
          "kind": "zone",
          "label": "Zone",
          "label_field": "name",
          "children": [
            {
              "object": "playlist",
              "label": "Playlist",
              "children": [
                {
                  "fields": {
                    "ab_handover": {
                      "field": "ab_handover",
                      "label": "A/B : l'élément de l'autre lecteur au lancement (keep / cut / fade)",
                      "always": true
                    },
                    "ab_handover_ms": {
                      "field": "ab_handover_ms",
                      "label": "A/B : durée du fondu de passage (ms)",
                      "always": true
                    },
                    "auto": {
                      "field": "auto",
                      "label": "Enchaînement automatique",
                      "always": true
                    },
                    "loop": {
                      "field": "loop",
                      "label": "Boucler la liste",
                      "always": true
                    }
                  },
                  "label": "Options"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "actions": [
    {
      "id": "fire",
      "label": "Appuyer sur une touche (lancer, ou son deuxième appui)",
      "endpoint": "/fire",
      "params": [
        {
          "key": "key",
          "label": "Touche",
          "type": "text",
          "options_endpoint": "/keys"
        }
      ]
    },
    {
      "id": "stop",
      "label": "Arrêter une touche (avec son fondu)",
      "endpoint": "/stop",
      "params": [
        {
          "key": "key",
          "label": "Touche",
          "type": "text",
          "options_endpoint": "/keys"
        }
      ]
    },
    {
      "id": "stop_all",
      "label": "Tout arrêter (fondus)",
      "endpoint": "/stop_all",
      "body": {
        "cut": false
      },
      "params": [
        {
          "key": "zone",
          "label": "Zone (vide = zone par défaut)",
          "type": "text",
