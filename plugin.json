          "options_endpoint": "/zones"
        }
      ]
    },
    {
      "id": "stop_all_cut",
      "label": "Tout couper (sans fondu)",
      "endpoint": "/stop_all",
      "body": {
        "cut": true
      },
      "params": [
        {
          "key": "zone",
          "label": "Zone (vide = zone par défaut)",
          "type": "text",
          "optional": true,
          "options_endpoint": "/zones"
        }
      ]
    },
    {
      "id": "page",
      "label": "Aller à une page",
      "endpoint": "/page",
      "params": [
        {
          "key": "page",
          "label": "Page",
