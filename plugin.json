          "optional": true,
          "options_endpoint": "/zones"
        }
      ]
    },
    {
      "id": "pl_prev",
      "label": "Playlist : précédent",
      "endpoint": "/pl/prev",
      "params": [
        {
          "key": "zone",
          "label": "Zone (vide = zone par défaut)",
          "type": "text",
          "optional": true,
          "options_endpoint": "/zones"
        }
      ]
    },
    {
      "id": "pl_goto",
